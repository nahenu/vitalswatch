# Copy to .env.local for local development.

# Random string used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public URL of the app (auth callbacks, alert links, badge snippets).
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Free PageSpeed Insights key (no billing needed). Without it Google rate-limits checks.
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# Vercel sends this with the daily cron request. Also unlocks the demo seed in production.
CRON_SECRET=

# Optional: send slowdown alerts and password resets through Resend.
RESEND_API_KEY=

# Leave empty locally to use the built-in PGlite database in ./.data.
DATABASE_URL=
